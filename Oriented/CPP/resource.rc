#include "resource.h"
#include <winres.h>

// Icons
IDI_APPICON  ICON "app.ico"
IDI_UNLOCKED ICON "unlocked.ico"
IDI_LOCKED   ICON "locked.ico"

// Background image
IDR_BACKGROUND RCDATA "app.png"

// Application manifest
1 RT_MANIFEST "app.manifest"

// Version info
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "HALRAD"
            VALUE "FileDescription", "Screen Orientation Utility"
            VALUE "FileVersion", "1.0.0.0"
            VALUE "InternalName", "Oriented"
            VALUE "OriginalFilename", "Oriented.exe"
            VALUE "ProductName", "Oriented"
            VALUE "ProductVersion", "1.0.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
